# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Redis
REDIS_URL=redis://localhost:6380

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db

# Anthropic Claude API (required)
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-5

# Embeddings: Uses free local sentence-transformers (no API key needed)
# Model: sentence-transformers/all-MiniLM-L6-v2 (384 dimensions)
# Install: pip install sentence-transformers

# Optional local LLM fallback
OLLAMA_BASE_URL=http://localhost:11434

# External APIs
GITHUB_TOKEN=your_github_token
GITHUB_ORG=your_github_org
VERCEL_TOKEN=your_vercel_token
VERCEL_TEAM_ID=your_vercel_team_id

# Get from: Vercel project → Settings → Git → Deploy Hooks
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/your_hook_id
RAILWAY_TOKEN=your_railway_token

# Get from: Railway project → Settings → Deploy Hooks
RAILWAY_DEPLOY_HOOK_URL=https://railway.app/api/deploy-hook/your_hook_id

# Note: Agents will automatically set up git hooks and GitHub Actions workflows when these are configured
RESEND_API_KEY=your_resend_api_key
E2B_API_KEY=your_e2b_api_key

# Paths (optional - knowledge_base folder created automatically if needed)
KNOWLEDGE_BASE_DIR=./knowledge_base
# Project directory where agents build the product (separate repo, created automatically)
PROJECT_DIR=./product

# Logging / environment
LOG_LEVEL=INFO
ENVIRONMENT=development

# Orchestration intervals (seconds)
CEO_LOOP_INTERVAL=300
CTO_LOOP_INTERVAL=120

# Founder contact
FOUNDER_EMAIL=founder@example.com
