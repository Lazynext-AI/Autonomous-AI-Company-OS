# Cloudflare Worker (D1 + KV + Vectorize API layer)
# Deploy worker/ first: cd worker && npx wrangler deploy
CLOUDFLARE_API_URL=https://ai-company-os.<your-account>.workers.dev
CLOUDFLARE_API_TOKEN=your_shared_worker_secret

# Cloudflare account credentials (wrangler, deployments, resource management)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
# Scoped API token - preferred. Create at dash.cloudflare.com -> My Profile -> API Tokens
# Permissions: Workers Scripts, Workers KV, D1, Vectorize, Pages, Workers Containers (Edit)
CLOUDFLARE_DEPLOY_TOKEN=your_scoped_api_token
# Fallback: global key + email (not needed when the scoped token above is set)
CLOUDFLARE_API_KEY=your_cloudflare_global_api_key
CLOUDFLARE_EMAIL=your_cloudflare_account_email

# LLM brain — Cloudflare Workers AI is primary (Llama-3.3-70b, free, no key).

# Embeddings: free local sentence-transformers (no API key needed)
# Model: sentence-transformers/all-MiniLM-L6-v2 (384 dimensions)
# Install: pip install sentence-transformers

# External APIs (optional)
# GitHub: repo creation, push, Actions monitoring. Token needs repo + workflow scopes.
GITHUB_TOKEN=your_github_token
# Brevo: transactional + campaign email (briefings also appear on the dashboard)
# Key: brevo.com → SMTP & API → API Keys. Or set conn:brevo in Settings.
BREVO_API_KEY=your_brevo_api_key
# SignWell: e-signature API (free tier 25 docs/mo). Key: signwell.com/app → Settings → API.
# Or set conn:signwell in Settings. Prefix "test:" enables unlimited test-mode sends.
SIGNWELL_API_KEY=your_signwell_api_key
# Code execution — Cloudflare container sandbox is primary (worker /exec route).

# Dodo Payments (billing — create products in the Dodo dashboard)
DODO_API_KEY=your_dodo_api_key
DODO_WEBHOOK_SECRET=your_dodo_webhook_secret
DODO_PRODUCT_COMPANY=your_dodo_product_id_company
DODO_PRODUCT_SCALE=your_dodo_product_id_scale

# Web search — Serper.dev (real Google results). Get a key at serper.dev.
SERPER_API_KEY=your_serper_api_key
# Page scraping — Cloudflare Browser Rendering is primary (headless Chromium on

# Paths (optional - knowledge_base folder created automatically if needed)
KNOWLEDGE_BASE_DIR=./knowledge_base
# Base directory for product repos (one repo per product in company brain)
PRODUCTS_BASE_DIR=./products

# Logging / environment
LOG_LEVEL=INFO
ENVIRONMENT=development

# Orchestration intervals (seconds)
CEO_LOOP_INTERVAL=300
CTO_LOOP_INTERVAL=120

# Founder contact (weekly briefing emails via Brevo - optional)
FOUNDER_EMAIL=founder@example.com
LAZYNEXT_API_KEY=lzk_your_public_key
